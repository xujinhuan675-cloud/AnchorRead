# Server-side LLM configuration (optional)
# If configured, users can access via ACCESS_PASSWORD instead of providing their own API keys
# SERVER_LLM_TYPE=openai
# SERVER_LLM_BASE_URL=https://api.openai.com/v1
# SERVER_LLM_API_KEY=sk-your-api-key-here
# SERVER_LLM_MODEL=gpt-4
# ACCESS_PASSWORD=your-secure-password

# Remote MCP browser bridge (required for a deployed same-origin AnchorRead page)
# ANCHORREAD_DIAGRAM_REMOTE_BRIDGE=true
# OAuth access-token hashes and browser bindings persist in this file:
# ANCHORREAD_MCP_PAIRING_STORE_PATH=/data/diagram-mcp-pairings.json
# OAuth clients, pending grants, authorization-code hashes, and refresh-token hashes persist here:
# ANCHORREAD_MCP_OAUTH_STORE_PATH=/data/diagram-mcp-oauth.json
# Browser presence, MCP sessions, and requests still require a single Node process.
# Optional CORS allowlist for browser MCP clients (comma-separated origins):
# ANCHORREAD_MCP_ALLOWED_ORIGINS=https://chat.example.com

# Sentry performance monitoring (optional; disabled when SENTRY_DSN is empty)
# SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0 # optional override; defaults to SENTRY_DSN
# SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=anchor-read@0.1.0
# NEXT_PUBLIC_SENTRY_RELEASE=anchor-read@0.1.0
# SENTRY_TRACES_SAMPLE_RATE=0.2
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.2

# Required only during production builds that upload source maps
# SENTRY_ORG=your-organization
# SENTRY_PROJECT=anchor-read
# SENTRY_AUTH_TOKEN=sntrys_your-build-token



